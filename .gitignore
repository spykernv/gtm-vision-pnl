# Only code, generic documentation, and synthetic examples are versioned.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/LICENSE
!/pyproject.toml
!/requirements.txt
!/gtm.ps1
!/.claude/
!/scripts/
!/tests/
!/docs/
!/examples/
__pycache__/
*.pyc
.env*
*.xlsx
*.csv
*.log
**/local/
**/backups/
**/secrets/
